<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    
    <!-- Microsoft.Data.SqlClient brings System.Security.Cryptography.Pkcs 9.0.11, which NuGet audit fails on
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); 9.0.21 is the patched one. Drop it with a platform that brings it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="VirtoCommerce.Platform.Data.SqlServer" Version="3.1076.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.ContentModule.Data\VirtoCommerce.ContentModule.Data.csproj" />
  </ItemGroup>
</Project>